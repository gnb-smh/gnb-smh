# Read-only explorer API for gnb-smh.com, in front of the local GnB node.
#
# Default (WAL-2/WAL-4): loopback only, published through a Cloudflare Tunnel
# (cloudflared-gnb-explorer.service). For direct TLS instead, set
# GNB_API_BIND=0.0.0.0 plus GNB_API_TLS_CERT/GNB_API_TLS_KEY and apply
# firewall-cloudflare.sh so only Cloudflare can connect. See README.md.
#
# Audit OPS-3: the API faces the internet (through the Worker), so it runs
# as its OWN system user, not as the node's `gnb` user: a compromise of the
# API process cannot read or write the node's data dir (/var/lib/gnb, mode
# 0700 gnb) or its keys. Create the user once:
#   useradd --system --no-create-home --home-dir /nonexistent \
#           --shell /usr/sbin/nologin gnb-api
# and give it the secret: install -m 0640 -o root -g gnb-api ... (README.md).
# Check the sandbox with `systemd-analyze security gnb-explorer-api`;
# deploy/test_deploy_files.py keeps the directives below in place.
[Unit]
Description=GnB explorer API (read-only)
After=gnb-node.service
Wants=gnb-node.service

[Service]
User=gnb-api
Group=gnb-api
Environment=GNB_RPC_URL=http://127.0.0.1:17210/
Environment=GNB_API_BIND=127.0.0.1
Environment=GNB_API_PORT=2086
Environment=GNB_API_KEY_FILE=/etc/gnb/explorer-api.key
Environment=GNB_CARRYOVER=/opt/gnb/carryover.tsv
Environment=GNB_API_MAX_CONNECTIONS=64
Environment=GNB_API_TIMEOUT=10
Environment=GNB_API_DEADLINE=30
# Direct-TLS mode only (key readable by the gnb-api user, mode 0640
# root:gnb-api; also remove the IPAddressDeny/IPAddressAllow lines below):
#Environment=GNB_API_BIND=0.0.0.0
#Environment=GNB_API_PORT=2087
#Environment=GNB_API_TLS_CERT=/etc/gnb/explorer-api.crt
#Environment=GNB_API_TLS_KEY=/etc/gnb/explorer-api.tls.key
ExecStart=/usr/bin/python3 -I /opt/gnb/bin/gnb_explorer_api.py
Restart=always
RestartSec=3
MemoryMax=1G
TasksMax=128
UMask=0077

# ── Sandboxing (audit OPS-3) ────────────────────────────────────────────────
# The API reads its key, its TLS files and the carryover snapshot, talks to
# the node's loopback RPC and serves HTTP(S). It writes nothing.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateUsers=true
PrivateIPC=true
RemoveIPC=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
# No capabilities: it listens on an unprivileged port.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Tunnel layout: only loopback peers (cloudflared, the node). Remove both
# lines for the direct-TLS layout (the firewall then restricts the port).
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# CPython without its experimental JIT and without ctypes callbacks: no
# writable-executable mappings.
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private

[Install]
WantedBy=multi-user.target
